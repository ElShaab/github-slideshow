# Copy to .env (or paste into Replit Secrets) and fill in what you have.
# Nothing here is required to run the dashboard: Reddit and PubMed work with
# no credentials at all.

# --- Server ---------------------------------------------------------------
PORT=3000
# Path to the SQLite file, relative to the dashboard/ directory.
DB_PATH=data/dashboard.db
# Set to false to run the UI without any background polling.
POLLING_ENABLED=true
# Reddit asks for a descriptive, unique User-Agent on its public endpoints.
USER_AGENT=amputee-research-dashboard/1.0 (contact: you@example.com)

# --- X (Twitter) API v2 ---------------------------------------------------
# developer.x.com -> Project -> Keys and tokens -> Bearer Token.
# Recent search (/2/tweets/search/recent) needs at least the Basic tier.
X_BEARER_TOKEN=

# --- YouTube Data API v3 --------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> API key,
# with "YouTube Data API v3" enabled for the project.
YOUTUBE_API_KEY=

# --- Web search discovery (Quora, Inspire, any domain) --------------------
# Picks up discussions on sites that have no API of their own by asking a
# licensed search index for site-scoped matches. Only the search API's own
# titles, snippets and links are stored; the pages themselves are never
# fetched. Set the key for whichever provider you select in the Sources tab.
#
# Brave Search API (free tier: 2,000 queries/month) - api-dashboard.search.brave.com
BRAVE_SEARCH_API_KEY=
# Google Programmable Search (free tier: 100 queries/day). The key comes from
# console.cloud.google.com with "Custom Search API" enabled; the engine ID
# (cx) from programmablesearchengine.google.com, set to search the whole web.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# --- Replying from the dashboard ------------------------------------------
# Posting a reply uses your own linked account, not the read-only credentials
# above. Register an app on each platform, set the redirect URI it shows in
# Sources -> Linked accounts, then press Connect.
#
# Public address of this dashboard, used to build those redirect URIs. On
# Replit this is the webview URL.
PUBLIC_URL=

# reddit.com/prefs/apps -> create app -> "web app"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# developer.x.com -> User authentication settings -> OAuth 2.0, Read and write.
# Leave the secret empty for a public (PKCE-only) client.
X_CLIENT_ID=
X_CLIENT_SECRET=

# console.cloud.google.com -> Credentials -> OAuth client ID (Web application),
# with the YouTube Data API v3 enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the stored OAuth tokens. Without it a random key is generated and
# kept in the database, which is weaker: set this to any long random string.
TOKEN_SECRET=

# Once an account is linked, anyone who can reach this URL can post as you.
# Set a password to put the whole dashboard behind HTTP Basic auth.
DASHBOARD_PASSWORD=
DASHBOARD_USER=dashboard

# --- Draft reply generation (Anthropic API) -------------------------------
# Required for the "Generate draft" button. On Replit put this in the Secrets
# panel, never in a file. Everything else in the dashboard works without it.
# Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# --- Research matching ----------------------------------------------------
# Five of the six research databases need no credentials at all. A Semantic
# Scholar key (semanticscholar.org/product/api) only raises its rate limit.
SEMANTIC_SCHOLAR_API_KEY=

# --- PubMed E-utilities (optional) ----------------------------------------
# Without a key NCBI allows ~3 requests/second, which is plenty here.
# A key (ncbi.nlm.nih.gov/account) raises it to 10/second.
PUBMED_API_KEY=
PUBMED_EMAIL=
PUBMED_TOOL=amputee-research-dashboard
