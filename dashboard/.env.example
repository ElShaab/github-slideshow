# Copy to .env (or paste into Replit Secrets) and fill in what you have.
# Nothing here is required to run the dashboard: Reddit and PubMed work with
# no credentials at all.

# --- Server ---------------------------------------------------------------
PORT=3000
# Path to the SQLite file, relative to the dashboard/ directory.
DB_PATH=data/dashboard.db
# Set to false to run the UI without any background polling.
POLLING_ENABLED=true
# Reddit asks for a descriptive, unique User-Agent on its public endpoints.
USER_AGENT=amputee-research-dashboard/1.0 (contact: you@example.com)

# --- X (Twitter) API v2 ---------------------------------------------------
# developer.x.com -> Project -> Keys and tokens -> Bearer Token.
# Recent search (/2/tweets/search/recent) needs at least the Basic tier.
X_BEARER_TOKEN=

# --- YouTube Data API v3 --------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> API key,
# with "YouTube Data API v3" enabled for the project.
YOUTUBE_API_KEY=

# --- Web search discovery (Quora, Inspire, any domain) --------------------
# Picks up discussions on sites that have no API of their own by asking a
# licensed search index for site-scoped matches. Only the search API's own
# titles, snippets and links are stored; the pages themselves are never
# fetched. Set the key for whichever provider you select in the Sources tab.
#
# Brave Search API (free tier: 2,000 queries/month) - api-dashboard.search.brave.com
BRAVE_SEARCH_API_KEY=
# Google Programmable Search (free tier: 100 queries/day). The key comes from
# console.cloud.google.com with "Custom Search API" enabled; the engine ID
# (cx) from programmablesearchengine.google.com, set to search the whole web.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# --- PubMed E-utilities (optional) ----------------------------------------
# Without a key NCBI allows ~3 requests/second, which is plenty here.
# A key (ncbi.nlm.nih.gov/account) raises it to 10/second.
PUBMED_API_KEY=
PUBMED_EMAIL=
PUBMED_TOOL=amputee-research-dashboard
