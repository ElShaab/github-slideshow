# ---------------------------------------------------------------------------
# GetFit — environment configuration
# Copy to .env and fill in. Never commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/getfit
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# With DATABASE_SSL=true the server certificate is verified. For a self-signed
# certificate, point this at its CA bundle (PEM contents, not a path).
DATABASE_CA_CERT=
# Skips verification entirely. Local development only — production refuses to
# start with this set, because encrypting without checking who answers stops a
# passive eavesdropper but not an active one.
DATABASE_SSL_INSECURE=false

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
# The server refuses to boot in production while this is left at the default.
JWT_SECRET=change-me-before-deploying
JWT_EXPIRES_IN=30d

# --- Body analysis ---------------------------------------------------------
# Body composition is computed locally from the user's tape measurements using
# published anthropometric formulas (US Navy circumference, with Deurenberg as
# the fallback). No AI service, no credentials, no per-request cost — in
# development and in production alike.
#
# Leave AI_PROVIDER empty to use it. Setting it swaps in a remote vision
# endpoint instead, and then the URL and key are both required.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=

# --- Development mode ------------------------------------------------------
# DEV_MODE exposes /api/dev test helpers. MOCK_BILLING enables the mock store,
# which would hand out free memberships against forged receipts.
# Production refuses to boot while either is true (see the checklist below).
DEV_MODE=true
MOCK_BILLING=true

# --- Photo storage ---------------------------------------------------------
# Photos are private. They are never served from a public URL.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/photos
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
MAX_PHOTO_BYTES=12582912

# --- Apple In-App Purchase -------------------------------------------------
APPLE_BUNDLE_ID=com.getfit.app
APPLE_SHARED_SECRET=
APPLE_VERIFY_URL=https://buy.itunes.apple.com/verifyReceipt
APPLE_SANDBOX_VERIFY_URL=https://sandbox.itunes.apple.com/verifyReceipt

# --- Google Play Billing ---------------------------------------------------
GOOGLE_PACKAGE_NAME=com.getfit.app
# The full service-account JSON on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Networking / logging --------------------------------------------------
CORS_ORIGINS=*
LOG_LEVEL=info

# --- Mobile client ---------------------------------------------------------
# Read by the Expo app at build time.
EXPO_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Production checklist
#
# With NODE_ENV=production the server validates its own configuration on boot
# and exits with the full list of problems rather than starting in a degraded
# state. Every line below must hold:
#
#   JWT_SECRET                   random, at least 32 characters
#   MOCK_BILLING                 false      (else receipts are never verified)
#   DEV_MODE                     false      (else /api/dev helpers are exposed)
#   AI_PROVIDER                  optional; if set, AI_BASE_URL and AI_API_KEY
#                                must be set too
#   CORS_ORIGINS                 explicit origins, never "*"
#   DATABASE_SSL_INSECURE        false      (use DATABASE_CA_CERT instead)
#   STORAGE_DRIVER               s3         (local disk is ephemeral)
#   APPLE_SHARED_SECRET          set        (App Store receipt validation)
#   GOOGLE_SERVICE_ACCOUNT_JSON  set        (Play purchase validation)
# ---------------------------------------------------------------------------
