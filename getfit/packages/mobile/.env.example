# GetFit — build-time configuration.
#
# Copy to .env (which is gitignored) and fill in. EXPO_PUBLIC_ variables are
# inlined into the JavaScript bundle by Expo, so they are readable by anyone who
# unpacks the app — only values that are meant to ship belong here.
#
# Leaving these unset is a supported configuration: the app then runs entirely
# on-device, exactly as it did before accounts existed.

# Project URL, from Supabase → Project Settings → Data API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The publishable key (sb_publishable_…), from Project Settings → API Keys.
# NOT the legacy anon JWT and NEVER the secret/service-role key: that one
# bypasses row-level security and must never reach a client.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
